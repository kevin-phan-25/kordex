{
  "annotations": {"list": []},
  "description": "Kordex control-plane request health. Starting point only; tune thresholds to service SLOs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(kordex_http_server_requests_total[5m]))", "legendFormat": "all requests", "refId": "A"}],
      "title": "Request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(kordex_http_server_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(kordex_http_server_requests_total[5m])), 0.001)", "legendFormat": "5xx share", "refId": "A"}],
      "title": "Server error share",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(kordex_http_server_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "A"}, {"expr": "histogram_quantile(0.50, sum by (le) (rate(kordex_http_server_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "B"}],
      "title": "Request latency percentiles",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["kordex", "operations"],
  "templating": {"list": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"}}]},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Kordex Control Plane",
