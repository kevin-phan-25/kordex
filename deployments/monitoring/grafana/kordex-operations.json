{
  "annotations": {"list": []},
  "description": "Kordex scheduler and local maintenance recovery signals. Metrics are bounded and contain no tenant or infrastructure identifiers.",
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "max(kordex_scheduler_queue_age_seconds)", "legendFormat": "oldest overdue tick", "refId": "A"}],
      "title": "Scheduler queue age",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "max(kordex_scheduler_active_reservations)", "legendFormat": "active reservations", "refId": "A"}],
      "title": "Retained operation reservations",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48},
      "id": 9,
      "targets": [{"expr": "max(kordex_scheduler_oldest_reservation_age_seconds)", "legendFormat": "oldest active reservation", "refId": "A"}],
      "title": "Oldest retained reservation age",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48},
      "id": 10,
      "targets": [
        {"expr": "sum by (action, outcome) (increase(kordex_operator_maintenance_operations_total[1h]))", "legendFormat": "{{action}} · {{outcome}}", "refId": "A"},
        {"expr": "sum by (action) (increase(kordex_operator_maintenance_recovery_required_total[1h]))", "legendFormat": "{{action}} · RecoveryRequired", "refId": "B"}
      ],
      "title": "Terminal outcomes and RecoveryRequired (1h)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 56},
      "id": 11,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, action) (rate(kordex_operator_maintenance_drain_duration_seconds_bucket[1h])))", "legendFormat": "{{action}} drain p95", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le, action) (rate(kordex_operator_maintenance_reboot_duration_seconds_bucket[1h])))", "legendFormat": "{{action}} reboot p95", "refId": "B"}
      ],
      "title": "Verified drain and reboot duration (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 64},
      "id": 12,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, action, outcome) (rate(kordex_operator_maintenance_operation_duration_seconds_bucket[1h])))", "legendFormat": "{{action}} · {{outcome}} p95", "refId": "A"}],
      "title": "Terminal operation duration (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "max by (reason) (kordex_scheduler_blocked_operations)", "legendFormat": "{{reason}}", "refId": "A"}],
      "title": "Blocked operations by reason",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (reason) (increase(kordex_operator_recovery_blocked_total[1h]))", "legendFormat": "{{reason}}", "refId": "A"}],
      "title": "Recovery safety blocks (1h)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(kordex_operator_recovery_duration_seconds_bucket[1h])))", "legendFormat": "p95 recovery duration", "refId": "A"}, {"expr": "histogram_quantile(0.50, sum by (le) (rate(kordex_operator_recovery_duration_seconds_bucket[1h])))", "legendFormat": "p50 recovery duration", "refId": "B"}],
      "title": "Completed recovery duration",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "id": 6,
      "targets": [{"expr": "sum by (class) (increase(kordex_scheduler_errors_total[1h]))", "legendFormat": "{{class}}", "refId": "A"}],
      "title": "Scheduler failures by class (1h)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32},
      "id": 7,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, from_phase, to_phase) (rate(kordex_operator_maintenance_phase_duration_seconds_bucket[15m])))", "legendFormat": "{{from_phase}} → {{to_phase}} p95", "refId": "A"}],
      "title": "Maintenance phase latency (p95, 15m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
      "id": 8,
      "targets": [{"expr": "sum by (phase, reason) (increase(kordex_operator_maintenance_blocked_total[1h]))", "legendFormat": "{{phase}} · {{reason}}", "refId": "A"}],
      "title": "Maintenance safety blocks (1h)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 72},
      "id": 13,
      "targets": [{"expr": "max(kordex_operator_oldest_active_recovery_age_seconds * (kordex_operator_recovery_age_snapshot_success == 1))", "legendFormat": "oldest active recovery", "refId": "A"}],
      "title": "Oldest active recovery age",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 72},
      "id": 14,
      "targets": [
        {"expr": "max(kordex_operator_active_recovery_operations * (kordex_operator_recovery_age_snapshot_success == 1))", "legendFormat": "active RecoveryRequired operations", "refId": "A"},
        {"expr": "max(kordex_operator_recovery_age_snapshot_complete * (kordex_operator_recovery_age_snapshot_success == 1))", "legendFormat": "snapshot complete (1=yes)", "refId": "B"}
      ],
      "title": "Active recovery count and snapshot completeness",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["kordex", "operations", "recovery", "upgrades"],
  "templating": {"list": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"}}]},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Kordex Operations",
  "uid": "kordex-operations",
  "version": 4
}
