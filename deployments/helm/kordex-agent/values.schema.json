{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mtls": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "clientCertificateSecretName": {"type": "string", "maxLength": 253},
        "serverCASecretName": {"type": "string", "maxLength": 253},
        "serverName": {"type": "string", "maxLength": 253}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "required": ["clientCertificateSecretName", "serverCASecretName", "serverName"],
            "properties": {
              "clientCertificateSecretName": {"minLength": 1},
              "serverCASecretName": {"minLength": 1},
              "serverName": {"minLength": 1, "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(\\.([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*$"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "otlpEndpoint": {"type": "string", "maxLength": 2048, "pattern": "^(|https?://(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9.-]+)(:[0-9]{1,5})?(/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?)$"}
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "egress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/networkPolicyEgressRule"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "podSelector": {
      "type": "object",
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "operator"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "type": "string",
                "enum": [
                  "In",
                  "NotIn",
                  "Exists",
                  "DoesNotExist"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "matchLabels"
          ]
        },
        {
          "required": [
            "matchExpressions"
          ]
        }
      ],
      "additionalProperties": false
    },
    "networkPolicyPeer": {
      "type": "object",
      "properties": {
        "namespaceSelector": {
          "$ref": "#/definitions/podSelector"
        },
        "podSelector": {
          "$ref": "#/definitions/podSelector"
        },
        "ipBlock": {
          "type": "object",
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "type": "string",
              "minLength": 1
            },
            "except": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "not": {
            "required": [
              "cidr"
            ],
            "properties": {
              "cidr": {
                "enum": [
                  "0.0.0.0/0",
                  "::/0"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "anyOf": [
        {
          "required": [
            "namespaceSelector"
          ]
        },
        {
          "required": [
            "podSelector"
          ]
        },
        {
          "required": [
            "ipBlock"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "ipBlock"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "namespaceSelector"
                  ]
                },
                {
                  "required": [
                    "podSelector"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "networkPolicyEgressRule": {
      "type": "object",
      "required": [
        "to",
        "ports"
      ],
      "properties": {
        "to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/networkPolicyPeer"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "protocol",
              "port"
            ],
            "properties": {
              "protocol": {
                "type": "string",
                "enum": [
                  "TCP",
                  "UDP"
                ]
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
