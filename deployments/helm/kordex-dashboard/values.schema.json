{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "oidc": {
      "type": "object",
      "properties": {
        "apiTokenMode": {"type": "string", "enum": ["id_token", "access_token"]},
        "apiScopes": {"type": "string", "anyOf": [{"const": ""}, {"pattern": "^[^\\s]+(?:\\s+[^\\s]+)*$"}]}
      },
      "additionalProperties": true
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "dashboardFrom": {
              "type": "array",
              "items": {"$ref": "#/definitions/networkPolicyPeer"}
            }
          },
          "additionalProperties": true
        },
        "egress": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "commonTo": {"type": "array", "items": {"$ref": "#/definitions/networkPolicyEgressRule"}},
            "dashboardTo": {"type": "array", "items": {"$ref": "#/definitions/networkPolicyEgressRule"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "podSelector": {
      "type": "object",
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string"}
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "operator"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "operator": {"type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
              "values": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "anyOf": [
        {"required": ["matchLabels"]},
        {"required": ["matchExpressions"]}
      ],
      "additionalProperties": false
    },
    "networkPolicyPeer": {
      "type": "object",
      "properties": {
        "namespaceSelector": {"$ref": "#/definitions/podSelector"},
        "podSelector": {"$ref": "#/definitions/podSelector"},
        "ipBlock": {
          "type": "object",
          "required": ["cidr"],
          "properties": {
            "cidr": {"type": "string", "minLength": 1},
            "except": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "not": {
            "required": ["cidr"],
            "properties": {"cidr": {"enum": ["0.0.0.0/0", "::/0"]}}
          },
          "additionalProperties": false
        }
      },
      "anyOf": [
        {"required": ["namespaceSelector"]},
        {"required": ["podSelector"]},
        {"required": ["ipBlock"]}
      ],
      "allOf": [
        {
          "if": {"required": ["ipBlock"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["namespaceSelector"]},
                {"required": ["podSelector"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "networkPolicyEgressRule": {
      "type": "object",
      "required": ["to", "ports"],
      "properties": {
        "to": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/networkPolicyPeer"}},
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["protocol", "port"],
            "properties": {
              "protocol": {"type": "string", "enum": ["TCP", "UDP"]},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
