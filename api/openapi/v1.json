{
  "openapi": "3.0.3",
  "info": {
    "title": "Infrastructure Lifecycle Management API",
    "version": "0.1.0",
    "description": "Phase 1 isolated bootstrap API. Global administrative bearer credential; production OIDC/RBAC not implemented. Maximum JSON body 16 KiB. Creates return 409 for existing names; no maintenance commands are exposed. List endpoints reject unknown or repeated query parameters."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Isolated local development only"
    }
  ],
  "paths": {
