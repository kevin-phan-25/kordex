  "components": {
    "securitySchemes": {
      "bootstrapBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Generated development-only global admin token; minimum 32 characters."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "CreateOrganization": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "No surrounding whitespace or control characters; maximum 128 UTF-8 bytes."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "CreateSite": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "No surrounding whitespace or control characters; maximum 128 UTF-8 bytes."
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "No surrounding whitespace or control characters; maximum 128 UTF-8 bytes."
          }
        },
        "required": [
          "name",
          "region"
        ],
        "additionalProperties": false
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "No surrounding whitespace or control characters; maximum 128 UTF-8 bytes."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "Site": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "No surrounding whitespace or control characters; maximum 128 UTF-8 bytes."
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "No surrounding whitespace or control characters; maximum 128 UTF-8 bytes."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "organizationId",
          "name",
          "region",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "OrganizationPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organization"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "additionalProperties": false
      },
      "SitePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Site"
            }
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "additionalProperties": false
