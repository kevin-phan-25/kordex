{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kordex.invalid/schemas/m3-release-lock-verification-input-v1.json",
  "title": "Local path map for M3 offline release-lock verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaign", "releaseTag", "sourceCommit", "workflowRun", "sigstoreTrustedRoot", "sigstoreTrustedRootSHA256", "imageAttestationMaxAgeDays", "packagePolicy", "packagePolicySHA256", "repositorySnapshotID", "privateMirrorURL", "repositoryMetadata"],
  "properties": {
    "schemaVersion": {"const": 1}, "campaign": {"enum": ["debian-13", "rhel-9.8+"]},
    "releaseTag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sourceCommit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "workflowRun": {"type": "object", "additionalProperties": false, "required": ["id", "attempt"], "properties": {"id": {"type": "string", "pattern": "^[0-9]+$"}, "attempt": {"type": "string", "pattern": "^[0-9]+$"}}},
    "sigstoreTrustedRoot": {"type": "string", "minLength": 1}, "sigstoreTrustedRootSHA256": {"$ref": "#/$defs/sha256"},
    "imageAttestationMaxAgeDays": {"type": "integer", "minimum": 1, "maximum": 365},
    "packagePolicy": {"type": "string", "minLength": 1}, "packagePolicySHA256": {"$ref": "#/$defs/sha256"},
    "repositorySnapshotID": {"type": "string", "minLength": 1}, "privateMirrorURL": {"type": "string", "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"},
    "repositoryMetadata": {"type": "object", "additionalProperties": false, "required": ["family", "keyring", "approvedFingerprints", "maxAgeSeconds", "repositories"], "properties": {
      "family": {"enum": ["debian", "rhel"]}, "keyring": {"type": "string", "minLength": 1},
      "approvedFingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Fa-f0-9]{40,64}$"}},
      "maxAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 604800}, "repositories": {"type": "array", "minItems": 1, "items": {"type": "object"}}
    }}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
