{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kordex.invalid/schemas/m3-trust-state-conformance-run-report-v1.json",
  "title": "M3 customer trust-state backend conformance run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runnerSourceCommit", "bootstrapSha256", "adapterDistribution", "adapterVersion", "adapterTreeSha256", "backendExecution", "productionTrustAccepted", "independentReviewRequired", "qualificationRowsAdvanced"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runnerSourceCommit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "bootstrapSha256": {"$ref": "#/$defs/sha256"},
    "adapterDistribution": {"type": "string", "minLength": 2},
    "adapterVersion": {"type": "string", "minLength": 1},
    "adapterTreeSha256": {"$ref": "#/$defs/sha256"},
    "backendExecution": {"$ref": "#/$defs/execution"},
    "productionTrustAccepted": {"const": false},
    "independentReviewRequired": {"const": true},
    "qualificationRowsAdvanced": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{2,127}$"},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["protocolVersion", "customerId", "backendIdentity", "endpointReference", "namespace", "tests", "auditEvents", "trustPolicyTests", "resultsSha256", "conformanceRootFingerprint", "conformanceReportCandidate", "backendContractChecks", "customerAdapterConformance", "unitOrFixtureExecution", "productionTrustAccepted", "requiresIndependentReview"],
      "properties": {
        "protocolVersion": {"const": "kordex-m3-trust-state-v1"},
        "customerId": {"$ref": "#/$defs/identity"},
        "backendIdentity": {"$ref": "#/$defs/identity"},
        "endpointReference": {"type": "string", "format": "uri", "pattern": "^https://"},
        "namespace": {"type": "string", "pattern": "^kordex-conformance-"},
        "tests": {"type": "array", "minItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "auditEvents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/auditEvent"}},
        "trustPolicyTests": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resultsSha256": {"$ref": "#/$defs/sha256"},
        "conformanceRootFingerprint": {"$ref": "#/$defs/sha256"},
        "conformanceReportCandidate": {"$ref": "#/$defs/reportCandidate"},
        "backendContractChecks": {"const": "EXECUTED"},
        "customerAdapterConformance": {"const": "NOT ESTABLISHED"},
        "unitOrFixtureExecution": {"const": false},
        "productionTrustAccepted": {"const": false},
        "requiresIndependentReview": {"const": true}
      }
    },
    "auditEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "backendIdentity", "customerId", "namespace", "transitionId", "sequence", "configurationSha256", "auditId", "observedAt", "recordedAt", "attestationFingerprint", "rootFingerprint", "rootSignatureSha256"],
      "properties": {
        "action": {"type": "string"}, "backendIdentity": {"$ref": "#/$defs/identity"},
        "customerId": {"$ref": "#/$defs/identity"}, "namespace": {"type": "string", "pattern": "^kordex-conformance-"},
        "transitionId": {"$ref": "#/$defs/identity"}, "sequence": {"type": "integer", "minimum": 0},
        "configurationSha256": {"$ref": "#/$defs/sha256"}, "auditId": {"$ref": "#/$defs/identity"},
        "observedAt": {"type": "string", "format": "date-time"}, "recordedAt": {"type": "string", "format": "date-time"},
        "attestationFingerprint": {"$ref": "#/$defs/sha256"}, "rootFingerprint": {"$ref": "#/$defs/sha256"},
        "rootSignatureSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reportCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "protocolVersion", "customerId", "backendIdentity", "endpointReference", "conformanceNamespace", "contractSuiteSha256", "resultsSha256", "decision", "reviewerIdentity", "reviewedAt", "expiresAt", "evidenceReference"],
      "properties": {
        "schemaVersion": {"const": 1}, "protocolVersion": {"const": "kordex-m3-trust-state-conformance-v1"},
        "customerId": {"$ref": "#/$defs/identity"}, "backendIdentity": {"$ref": "#/$defs/identity"},
        "endpointReference": {"type": "string", "format": "uri", "pattern": "^https://"},
        "conformanceNamespace": {"type": "string", "pattern": "^kordex-conformance-"},
        "contractSuiteSha256": {"$ref": "#/$defs/sha256"}, "resultsSha256": {"$ref": "#/$defs/sha256"},
        "decision": {"const": "pending-independent-review"}, "reviewerIdentity": {"const": "pending"},
        "reviewedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
        "evidenceReference": {"$ref": "#/$defs/identity"}
      }
    }
  }
}
