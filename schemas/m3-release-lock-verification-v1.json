{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kordex.invalid/schemas/m3-release-lock-verification-v1.json",
  "title": "Kordex M3 offline six-image release-lock verification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "status", "campaign", "releaseTag", "sourceCommit", "workflowRun", "verifier", "trust", "trustState", "sigstoreTrustedRootSha256", "repositoryMetadata", "lockCandidateSha256", "components", "inputSha256", "verifiedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "kordex-m3-release-lock-verification"},
    "status": {"const": "PASS"},
    "campaign": {"enum": ["debian-13", "rhel-9.8+"]},
    "releaseTag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sourceCommit": {"$ref": "#/$defs/gitCommit"},
    "workflowRun": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "attempt"],
      "properties": {"id": {"type": "string", "pattern": "^[0-9]+$"}, "attempt": {"type": "string", "pattern": "^[0-9]+$"}}
    },
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceCommit", "sourceTreeClean", "scriptSha256"],
      "properties": {"sourceCommit": {"$ref": "#/$defs/gitCommit"}, "sourceTreeClean": {"const": true}, "scriptSha256": {"$ref": "#/$defs/sha256"}}
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["configurationSha256", "rootFingerprint", "releaseLockSignerIdentity", "releaseLockSignerFingerprint", "releaseLockVerifierIdentity", "releaseLockVerifierFingerprint", "releaseLockVerifierSourceCommit", "signerSourceCommit", "verifierSourceCommit"],
      "properties": {"configurationSha256": {"$ref": "#/$defs/sha256"}, "rootFingerprint": {"$ref": "#/$defs/sha256"}, "releaseLockSignerIdentity": {"type": "string", "minLength": 1}, "releaseLockSignerFingerprint": {"$ref": "#/$defs/sha256"}, "releaseLockVerifierIdentity": {"type": "string", "minLength": 1}, "releaseLockVerifierFingerprint": {"$ref": "#/$defs/sha256"}, "releaseLockVerifierSourceCommit": {"$ref": "#/$defs/gitCommit"}, "signerSourceCommit": {"$ref": "#/$defs/gitCommit"}, "verifierSourceCommit": {"$ref": "#/$defs/gitCommit"}}
    },
    "trustState": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "configurationSha256", "backendIdentity", "namespace", "attestationFingerprint", "rootFingerprint", "rootSignatureSha256", "conformanceSha256", "auditIds"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "configurationSha256": {"$ref": "#/$defs/sha256"},
        "backendIdentity": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "attestationFingerprint": {"$ref": "#/$defs/sha256"},
        "rootFingerprint": {"$ref": "#/$defs/sha256"},
        "rootSignatureSha256": {"$ref": "#/$defs/sha256"},
        "conformanceSha256": {"$ref": "#/$defs/sha256"},
        "auditIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      }
    },
    "sigstoreTrustedRootSha256": {"$ref": "#/$defs/sha256"},
    "repositoryMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["resultSha256", "result"],
      "properties": {"resultSha256": {"$ref": "#/$defs/sha256"}, "result": {"type": "object"}}
    },
    "lockCandidateSha256": {"$ref": "#/$defs/sha256"},
    "components": {
      "type": "object", "additionalProperties": false,
      "required": ["agent", "operator", "control-plane", "dashboard", "ansible-ee", "postgres"],
      "properties": {
        "agent": {"$ref": "#/$defs/component"}, "operator": {"$ref": "#/$defs/component"},
        "control-plane": {"$ref": "#/$defs/component"}, "dashboard": {"$ref": "#/$defs/component"},
        "ansible-ee": {"$ref": "#/$defs/component"}, "postgres": {"$ref": "#/$defs/component"}
      }
    },
    "inputSha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "verifiedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["imageReference", "imageDigest", "sbomSha256", "sbomBundleSha256", "provenanceBundleSha256", "sourceRepository", "sourceRef", "sourceCommit", "builderId", "workflowIdentity", "buildType", "buildParameters", "materials", "sbomVerifiedAt", "provenanceVerifiedAt"],
      "properties": {
        "imageReference": {"type": "string", "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"},
        "imageDigest": {"$ref": "#/$defs/sha256"}, "sbomSha256": {"$ref": "#/$defs/sha256"},
        "sbomBundleSha256": {"$ref": "#/$defs/sha256"}, "provenanceBundleSha256": {"$ref": "#/$defs/sha256"},
        "provenanceSubjectDigest": {"$ref": "#/$defs/sha256"},
        "sourceRepository": {"type": "string", "minLength": 1}, "sourceRef": {"type": "string", "minLength": 1},
        "sourceCommit": {"$ref": "#/$defs/gitCommit"}, "builderId": {"type": "string", "minLength": 1},
        "workflowIdentity": {"type": "string", "minLength": 1}, "buildType": {"type": "string", "minLength": 1},
        "buildParameters": {"type": "object"}, "materials": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "sbomVerifiedAt": {"type": "string", "format": "date-time"}, "provenanceVerifiedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
