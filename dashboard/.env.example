# Public dashboard origin. Register ${KORDEX_DASHBOARD_URL}/api/auth/callback with the OIDC provider.
KORDEX_DASHBOARD_URL=https://dashboard.example.com
KORDEX_API_URL=https://api.example.com
KORDEX_OIDC_ISSUER=https://identity.example.com
KORDEX_OIDC_CLIENT_ID=kordex-dashboard
# Keep id_token unless the API is separately configured for RFC 9068 JWT access tokens.
KORDEX_OIDC_API_TOKEN_MODE=id_token
# Required only when KORDEX_OIDC_API_TOKEN_MODE=access_token.
# KORDEX_OIDC_API_SCOPES=kordex.read kordex.operate
# Generate with: openssl rand -base64 48. Store in the runtime secret manager.
KORDEX_SESSION_SECRET=replace-with-at-least-32-random-bytes
KORDEX_PRODUCT_NAME=Kordex
