# This example targets the separately designated Kordex qualification project.
# Never change gcloud's global project setting as part of lab setup.
project_id = "kordex-fleet-platform-515416"
terraform_principal_email = "<customer-approved-service-account>@kordex-fleet-platform-515416.iam.gserviceaccount.com"
allowed_project_ids = ["kordex-fleet-platform-515416"]
project_id_confirmation = "kordex-fleet-platform-515416"

region                  = "us-east1"
zone                    = "us-east1-b"
os_family               = "debian"
qualification_os_profile = "ubuntu-24.04" # The guarded plan binds this to the signed package policy.
name_prefix             = "kordex-lab"
machine_type            = "e2-standard-2"
boot_disk_size_gb       = 40
upgrade_ssh_user         = "kordex"

# Required before planning: acquire and approve the pinned K3s binary under the
# customer workflow in docs/m3-customer-artifact-approval.md. Verify the exact
# bytes copied from the internal mirror with the signed lock and independent
# artifact trust bundle; then set both values from that verified lock.
# k3s_binary_sha256 = "<digest-from-verified-customer-lock>"
# k3s_binary_mirror_url = "https://<customer-internal-mirror>/path/to/k3s"

# K3s system-image variables are intentionally not hand-entered in this file.
# The guarded plan/apply helper requires the local bundle, signed lock,
# detached signature, and independently provisioned trust bundle, verifies
# them offline, then supplies manifest/version/architecture/digest/URLs to
# Terraform directly. Direct Terraform plan/apply is unsupported.

# Required before planning: keep HTTPS mirror destinations separate from the
# workstation relay destination. Both accept only canonical RFC1918 CIDRs no
# broader than /24; mirrors are reachable on TCP/443, relay only on TCP/18443.
# The relay host firewall and KORDEX_RELAY_ALLOWED_CLIENT_CIDRS must separately
# allow the lab source subnet (10.76.0.0/24), not these destination CIDRs.
# approved_private_mirror_cidrs = ["<private-mirror-cidr>"]
# approved_private_relay_cidrs = ["<private-relay-cidr>"]
# ubuntu_apt_mirror_url = "https://<customer-private-ubuntu-mirror>/ubuntu"
# Debian 13 only: mirror trixie/trixie-updates and trixie-security separately,
# preserving signed repository metadata and Debian's archive keyring. The
# guarded artifact preflight supplies the selected current stable point release.
# debian_archive_mirror_url = "https://<customer-private-debian-mirror>/debian"
# debian_security_mirror_url = "https://<customer-private-debian-security-mirror>/debian-security"
# RHEL requires an exact approved image self-link and signed private RPM repo;
# 9.8 is the minimum and the current supported minor is selected by policy.

# No administrator CIDR, SSH key, or K3s token belongs in Terraform inputs.
# VM administration uses IAP/OS Login; the K3s agent token is runtime-created.
