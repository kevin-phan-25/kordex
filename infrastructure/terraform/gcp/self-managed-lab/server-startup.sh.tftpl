#!/usr/bin/env bash
set -euo pipefail
set +x

# No startup output is redirected to a shared log. Bootstrap credentials are
# handled only in process memory and are never emitted to serial output.
export DEBIAN_FRONTEND=noninteractive
OS_FAMILY='${os_family}'
OS_PROFILE='${qualification_os_profile}'
OS_MINOR='${qualification_os_minor}'
OS_POINT_RELEASE='${qualification_os_point_release}'
UBUNTU_APT_MIRROR_URL='${ubuntu_apt_mirror_url}'
DEBIAN_ARCHIVE_MIRROR_URL='${debian_archive_mirror_url}'
DEBIAN_SECURITY_MIRROR_URL='${debian_security_mirror_url}'
RHEL_REPOSITORY_BASEURL='${rhel_repository_baseurl}'
RHEL_REPOSITORY_GPG_KEY_PATH='${rhel_repository_gpg_key_path}'
RHEL_REPOSITORY_GPG_KEY_URL='${rhel_repository_gpg_key_url}'
RHEL_REPOSITORY_GPG_FINGERPRINT='${rhel_repository_gpg_fingerprint}'
RHEL_K3S_SELINUX_EVRA='${rhel_k3s_selinux_evra}'
RHEL_CONTAINER_SELINUX_EVRA='${rhel_container_selinux_evra}'
RHEL_POLICYCOREUTILS_EVRA='${rhel_policycoreutils_evra}'
PROJECT_ID='${project_id}'
SECRET_ID='${secret_id}'
K3S_VERSION='${k3s_version}'
K3S_ARCH=amd64
K3S_BINARY_SHA256='${k3s_binary_sha256}'
K3S_BINARY_MIRROR_URL='${k3s_binary_mirror_url}'
K3S_SYSTEM_IMAGES_MANIFEST_VERSION='${k3s_system_images_manifest_version}'
K3S_SYSTEM_IMAGES_K3S_VERSION='${k3s_system_images_k3s_version}'
K3S_SYSTEM_IMAGES_ARCHITECTURE='${k3s_system_images_architecture}'
K3S_SYSTEM_IMAGES_SHA256='${k3s_system_images_bundle_sha256}'
K3S_SYSTEM_IMAGES_MIRROR_URL='${k3s_system_images_bundle_mirror_url}'
K3S_SYSTEM_IMAGES_REGISTRY_HOST='${k3s_system_images_mirror_host}'
WORKER_NAMES=( '${worker_names[0]}' '${worker_names[1]}' )
BOOTSTRAP_STATE_DIR=/var/lib/kordex-lab
BOOTSTRAP_STATE_FILE="$${BOOTSTRAP_STATE_DIR}/join-state"
BOOTSTRAP_COMPLETE="$${BOOTSTRAP_STATE_DIR}/bootstrap-complete"

# GCE startup scripts run on every boot. Once the cluster bootstrap has
# completed, systemd owns K3s restart behavior; never issue another token.
if [[ -f "$${BOOTSTRAP_COMPLETE}" ]]; then
  exit 0
fi

if [[ "$${K3S_SYSTEM_IMAGES_MANIFEST_VERSION}" != 1 || \
      "$${K3S_SYSTEM_IMAGES_K3S_VERSION}" != "$${K3S_VERSION}" || \
      "$${K3S_SYSTEM_IMAGES_ARCHITECTURE}" != linux/amd64 || \
      ! "$${K3S_SYSTEM_IMAGES_SHA256}" =~ ^[a-f0-9]{64}$ || \
      ! "$${K3S_SYSTEM_IMAGES_REGISTRY_HOST}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9](:443)?$ ]]; then
  echo 'Customer-approved K3s system-image manifest inputs are missing or inconsistent' >&2
  exit 1
fi

ACTUAL_OS_ID="$(awk -F= '$1 == "ID" { gsub(/"/, "", $2); print $2 }' /etc/os-release)"
ACTUAL_OS_VERSION="$(awk -F= '$1 == "VERSION_ID" { gsub(/"/, "", $2); print $2 }' /etc/os-release)"
if [[ "$${OS_PROFILE}" == ubuntu-24.04 ]]; then
  EXPECTED_OS_ID=ubuntu
  EXPECTED_OS_VERSION=24.04
  EXPECTED_OS_FAMILY=debian
elif [[ "$${OS_PROFILE}" == debian-13 ]]; then
  EXPECTED_OS_ID=debian
  EXPECTED_OS_VERSION=13
  EXPECTED_OS_FAMILY=debian
elif [[ "$${OS_PROFILE}" == rhel-9 ]]; then
  EXPECTED_OS_ID=rhel
  EXPECTED_OS_VERSION=9
  EXPECTED_OS_FAMILY=rhel
else
  echo 'Unknown qualification OS profile' >&2
  exit 1
fi
if [[ "$${OS_FAMILY}" != "$${EXPECTED_OS_FAMILY}" || "$${ACTUAL_OS_ID}" != "$${EXPECTED_OS_ID}" ]]; then
  echo "Host OS identity does not match selected profile $${OS_PROFILE}" >&2
  exit 1
fi
if [[ "$${OS_PROFILE}" == ubuntu-24.04 || "$${OS_PROFILE}" == debian-13 ]]; then
  if [[ "$${ACTUAL_OS_VERSION}" != "$${EXPECTED_OS_VERSION}" ]]; then
    echo "Host OS version does not match selected profile $${OS_PROFILE}" >&2
    exit 1
  fi
elif [[ "$${ACTUAL_OS_VERSION%%.*}" != "$${EXPECTED_OS_VERSION}" ]]; then
  echo "Host OS major version does not match selected profile $${OS_PROFILE}" >&2
  exit 1
fi
if [[ "$${OS_PROFILE}" == rhel-9 ]]; then
  ACTUAL_OS_MINOR="$${ACTUAL_OS_VERSION#*.}"
  if [[ ! "$${ACTUAL_OS_MINOR}" =~ ^[0-9]+$ || "$${ACTUAL_OS_MINOR}" != "$${OS_MINOR}" || "$${ACTUAL_OS_MINOR}" -lt 8 || "$${ACTUAL_OS_VERSION}" != "$${OS_POINT_RELEASE}" ]]; then
    echo 'RHEL host minor release does not match the approved RHEL 9.8-or-later package policy' >&2
    exit 1
  fi
  RHEL_RELEASE_TEXT="$(cat /etc/redhat-release 2>/dev/null || true)"
  RHEL_RELEASE_VENDOR="$(rpm -q --qf '%%{VENDOR}' redhat-release 2>/dev/null || true)"
  RHUI_CLIENT_PACKAGE="$(rpm -qa --qf '%%{NAME}\n' | awk '$0 ~ /^google-rhui-client-rhel9([.-].*)?$/ && !found {print; found=1}')"
  if [[ "$${RHEL_RELEASE_TEXT}" != "Red Hat Enterprise Linux release $${OS_POINT_RELEASE}"* ||
        "$${RHEL_RELEASE_VENDOR}" != "Red Hat, Inc." ||
        -z "$${RHUI_CLIENT_PACKAGE}" ]]; then
    echo 'RHEL release provenance or Google RHUI/PAYG client entitlement is not verified' >&2
    exit 1
  fi
  [[ "$(rpm --eval '%%{_arch}')" == x86_64 ]] || { echo 'RHEL architecture is not x86_64' >&2; exit 1; }
else
  [[ "$${ACTUAL_OS_VERSION}" == "$${EXPECTED_OS_VERSION}" ]] || { echo 'Debian/Ubuntu OS version does not match profile' >&2; exit 1; }
fi
if [[ "$${OS_PROFILE}" == debian-13 ]]; then
  ACTUAL_DEBIAN_POINT_RELEASE="$(cat /etc/debian_version)"
  if [[ "$${ACTUAL_DEBIAN_POINT_RELEASE}" != 13.8 || "$${OS_POINT_RELEASE}" != 13.8 ]]; then
    echo 'Debian stable point release does not match the approved package policy' >&2
    exit 1
  fi
fi
if [[ "$${OS_FAMILY}" == debian ]] && [[ "$(dpkg --print-architecture)" != amd64 ]]; then
  echo "Host architecture does not match the selected linux/amd64 profile" >&2
  exit 1
fi

if [[ "$${OS_FAMILY}" == debian ]]; then
  # Remove image-provided sources so apt cannot fall back to a public archive.
  find /etc/apt/sources.list.d -maxdepth 1 -type f \
    \( -name '*.list' -o -name '*.sources' \) -delete
  rm -f /etc/apt/sources.list
  if [[ "$${OS_PROFILE}" == ubuntu-24.04 ]]; then
    cat > /etc/apt/sources.list.d/kordex-ubuntu.sources <<APT_SOURCES
Types: deb
URIs: $${UBUNTU_APT_MIRROR_URL}
Suites: noble noble-updates noble-backports noble-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
APT_SOURCES
  elif [[ "$${OS_PROFILE}" == debian-13 ]]; then
    cat > /etc/apt/sources.list.d/kordex-debian.sources <<APT_SOURCES
Types: deb
URIs: $${DEBIAN_ARCHIVE_MIRROR_URL}
Suites: trixie trixie-updates
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: $${DEBIAN_SECURITY_MIRROR_URL}
Suites: trixie-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
APT_SOURCES
  fi
  apt-get update
  apt-get install -y ca-certificates curl iptables openssh-server python3 sudo
elif [[ "$${OS_FAMILY}" == rhel ]]; then
  verify_single_gpg_fingerprint() {
    local key_file="$1"
    local expected_fp="$2"
    if [[ ! -f "$${key_file}" || -L "$${key_file}" ]]; then
      echo 'Customer-approved RHEL repository signing key is unavailable or unsafe' >&2
      return 1
    fi
    local gpg_home actual_fp
    gpg_home="$(mktemp -d)"
    chmod 0700 "$${gpg_home}"
    if ! actual_fp="$(gpg --homedir "$${gpg_home}" --batch --show-keys --with-colons "$${key_file}" 2>/dev/null | awk -F: '
      $1 == "sec" { invalid = 1; next }
      $1 == "pub" { pub++; if ($2 == "r" || $2 == "e" || $2 == "d" || $2 == "i") invalid = 1; expect_fpr = 1; next }
      $1 == "fpr" && expect_fpr { fpr = toupper($10); expect_fpr = 0; next }
      $1 != "fpr" { expect_fpr = 0 }
      END { if (pub == 1 && !invalid && fpr ~ /^[A-F0-9]{40}$/) print fpr }
    ')"; then
      rm -rf "$${gpg_home}"
      echo 'RHEL repository signing key could not be parsed' >&2
      return 1
    fi
    rm -rf "$${gpg_home}"
    if [[ -z "$${actual_fp}" || "$${actual_fp}" != "$${expected_fp^^}" ]]; then
      echo 'RHEL repository signing key fingerprint differs from the approved input or contains multiple keys' >&2
      return 1
    fi
  }

  rpm_exact_evra_installed() {
    local pkg_name="$1"
    local expected_evra="$2"
    local expected_norm="$${expected_evra}"
    if [[ "$${expected_norm}" != *:* ]]; then
      expected_norm="0:$${expected_norm}"
    fi
    local installed
    installed="$(rpm -q --qf '%%{EPOCHNUM}:%%{VERSION}-%%{RELEASE}.%%{ARCH}\n' "$${pkg_name}" 2>/dev/null)" || return 1
    [[ "$${installed}" == "$${expected_norm}" ]]
  }

  RHEL_REPO_URL_REGEX='^https://[A-Za-z0-9.-]+(:443)?(/[A-Za-z0-9._~%+@:-]+)*$'
  RHEL_KEY_URL_REGEX='^https://[A-Za-z0-9.-]+(:443)?(/[A-Za-z0-9._~%+@:-]+)+$'
  GITHUB_URL_REGEX='^https://([^/]*\.)?github\.com(:443)?(/|$)'
  if [[ ! "$${RHEL_REPOSITORY_BASEURL}" =~ $${RHEL_REPO_URL_REGEX} || \
        "$${RHEL_REPOSITORY_BASEURL,,}" =~ $${GITHUB_URL_REGEX} || \
        "$${RHEL_REPOSITORY_BASEURL}" == *'/../'* || \
        "$${RHEL_REPOSITORY_BASEURL}" == *'/..' ]]; then
    echo 'RHEL private repository URL is missing or malformed' >&2
    exit 1
  fi
  if [[ -n "$${RHEL_REPOSITORY_GPG_KEY_URL}" ]] && \
     [[ ! "$${RHEL_REPOSITORY_GPG_KEY_URL}" =~ $${RHEL_KEY_URL_REGEX} || \
        "$${RHEL_REPOSITORY_GPG_KEY_URL,,}" =~ $${GITHUB_URL_REGEX} || \
        "$${RHEL_REPOSITORY_GPG_KEY_URL}" == *'/../'* || \
        "$${RHEL_REPOSITORY_GPG_KEY_URL}" == *'/..' ]]; then
    echo 'RHEL repository signing key URL is malformed' >&2
    exit 1
  fi
  if [[ ! "$${RHEL_REPOSITORY_GPG_FINGERPRINT}" =~ ^[A-Fa-f0-9]{40}$ ]]; then
    echo 'RHEL repository signing key fingerprint is missing or malformed' >&2
    exit 1
  fi
  if [[ ! "$${RHEL_REPOSITORY_GPG_KEY_PATH}" =~ ^/etc/pki/rpm-gpg/[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo 'RHEL repository signing key path is missing or unsafe' >&2
    exit 1
  fi
  EVRA_REGEX='^((0|[1-9][0-9]*):)?[A-Za-z0-9.+~^]+-[A-Za-z0-9._+~^]+\.(x86_64|noarch)$'
  for pin_check in \
    "container-selinux:$${RHEL_CONTAINER_SELINUX_EVRA}" \
    "policycoreutils-python-utils:$${RHEL_POLICYCOREUTILS_EVRA}" \
    "k3s-selinux:$${RHEL_K3S_SELINUX_EVRA}"; do
    pin_evra="$${pin_check#*:}"
    if [[ ! "$${pin_evra}" =~ $${EVRA_REGEX} ]]; then
      echo "RHEL SELinux bootstrap package version pin is missing or malformed: $${pin_check%%:*}" >&2
      exit 1
    fi
  done

  if [[ -e "$${RHEL_REPOSITORY_GPG_KEY_PATH}" || -L "$${RHEL_REPOSITORY_GPG_KEY_PATH}" ]]; then
    verify_single_gpg_fingerprint "$${RHEL_REPOSITORY_GPG_KEY_PATH}" "$${RHEL_REPOSITORY_GPG_FINGERPRINT}"
  else
    if [[ -z "$${RHEL_REPOSITORY_GPG_KEY_URL}" ]]; then
      echo 'Customer-approved RHEL repository signing key is absent and no private mirror URL was provided' >&2
      exit 1
    fi
    key_dir="$(dirname "$${RHEL_REPOSITORY_GPG_KEY_PATH}")"
    if [[ -L "$${key_dir}" || ! -d "$${key_dir}" ]]; then
      echo 'RHEL repository signing key directory is unavailable or unsafe' >&2
      exit 1
    fi
    tmp_gpg_key="$(mktemp "$${key_dir}/.kordex-rpm-gpg.XXXXXX")"
    if ! curl -q --proto '=https' --max-redirs 0 --fail --silent --show-error \
      "$${RHEL_REPOSITORY_GPG_KEY_URL}" --output "$${tmp_gpg_key}" || \
      ! verify_single_gpg_fingerprint "$${tmp_gpg_key}" "$${RHEL_REPOSITORY_GPG_FINGERPRINT}"; then
      rm -f "$${tmp_gpg_key}"
      echo 'Fetched RHEL repository signing key failed download or approved fingerprint verification' >&2
      exit 1
    fi
    chown root:root "$${tmp_gpg_key}"
    chmod 0644 "$${tmp_gpg_key}"
    mv -f "$${tmp_gpg_key}" "$${RHEL_REPOSITORY_GPG_KEY_PATH}"
    verify_single_gpg_fingerprint "$${RHEL_REPOSITORY_GPG_KEY_PATH}" "$${RHEL_REPOSITORY_GPG_FINGERPRINT}"
  fi

  rpm --import "$${RHEL_REPOSITORY_GPG_KEY_PATH}"
  find /etc/yum.repos.d -maxdepth 1 \( -type f -o -type l \) -name '*.repo' -delete
  if [[ -e /etc/yum.repos.d/kordex-qualification.repo || -L /etc/yum.repos.d/kordex-qualification.repo ]]; then
    echo 'Refusing pre-existing or unsafe RHEL repository definition path' >&2
    exit 1
  fi
  cat > /etc/yum.repos.d/kordex-qualification.repo <<RPM_REPO
[kordex-qualification]
name=Kordex customer-approved qualification repository
baseurl=$${RHEL_REPOSITORY_BASEURL}
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file://$${RHEL_REPOSITORY_GPG_KEY_PATH}
skip_if_unavailable=0
metadata_expire=0
RPM_REPO
  dnf --disablerepo='*' --enablerepo=kordex-qualification \
    --setopt=gpgcheck=1 --setopt=repo_gpgcheck=1 --setopt=localpkg_gpgcheck=1 --setopt=skip_if_unavailable=0 \
    makecache --refresh

  # Install only explicitly version-pinned SELinux bootstrap packages from the
  # signed private repository when not already present at the exact approved EVRA.
  RHEL_SELINUX_INSTALL=()
  for pkg_spec in \
    "container-selinux:$${RHEL_CONTAINER_SELINUX_EVRA}" \
    "policycoreutils-python-utils:$${RHEL_POLICYCOREUTILS_EVRA}" \
    "k3s-selinux:$${RHEL_K3S_SELINUX_EVRA}"; do
    pkg_name="$${pkg_spec%%:*}"
    pkg_evra="$${pkg_spec#*:}"
    if ! rpm_exact_evra_installed "$${pkg_name}" "$${pkg_evra}"; then
      RHEL_SELINUX_INSTALL+=( "$${pkg_name}-$${pkg_evra}" )
    fi
  done
  if (( $${#RHEL_SELINUX_INSTALL[@]} > 0 )); then
    dnf --disablerepo='*' --enablerepo=kordex-qualification install -y \
      --setopt=gpgcheck=1 --setopt=repo_gpgcheck=1 --setopt=localpkg_gpgcheck=1 --setopt=skip_if_unavailable=0 \
      --setopt=install_weak_deps=False -- "$${RHEL_SELINUX_INSTALL[@]}"
  fi
  for pkg_spec in \
    "container-selinux:$${RHEL_CONTAINER_SELINUX_EVRA}" \
    "policycoreutils-python-utils:$${RHEL_POLICYCOREUTILS_EVRA}" \
    "k3s-selinux:$${RHEL_K3S_SELINUX_EVRA}"; do
    pkg_name="$${pkg_spec%%:*}"
    pkg_evra="$${pkg_spec#*:}"
    if ! rpm_exact_evra_installed "$${pkg_name}" "$${pkg_evra}"; then
      echo "Installed RHEL SELinux bootstrap package does not match approved EVRA: $${pkg_name}-$${pkg_evra}" >&2
      exit 1
    fi
  done
  rpm -q curl openssh-server python3 sudo firewalld >/dev/null
  [[ "$(getenforce)" == Enforcing ]] || { echo 'RHEL SELinux must remain Enforcing' >&2; exit 1; }
  grep -Eq '^[[:space:]]*SELINUX=enforcing[[:space:]]*$' /etc/selinux/config || { echo 'RHEL /etc/selinux/config must persist SELINUX=enforcing across reboots' >&2; exit 1; }
  semodule -l | awk '$1 == "k3s" {found=1} END {exit !found}' || { echo 'RHEL k3s SELinux policy module is not loaded' >&2; exit 1; }
  systemctl is-active --quiet firewalld || { echo 'RHEL firewalld must be active' >&2; exit 1; }
  systemctl is-enabled --quiet firewalld || { echo 'RHEL firewalld must remain enabled across reboots' >&2; exit 1; }
  firewall-cmd --permanent --zone=public --add-rich-rule='rule family=ipv4 source address=10.76.0.0/24 port port=6443 protocol=tcp accept'
  firewall-cmd --permanent --zone=public --add-rich-rule='rule family=ipv4 source address=10.76.0.0/24 port port=10250 protocol=tcp accept'
  firewall-cmd --permanent --zone=public --add-rich-rule='rule family=ipv4 source address=10.76.0.0/24 port port=8472 protocol=udp accept'
  firewall-cmd --permanent --zone=trusted --add-source=10.42.0.0/16
  firewall-cmd --permanent --zone=trusted --add-source=10.43.0.0/16
  firewall-cmd --reload
else
  echo "unsupported OS family" >&2
  exit 1
fi

if [[ "$(cat /proc/1/comm)" != systemd || ! -d /sys/fs/cgroup ]]; then
  echo 'K3s bootstrap requires systemd and mounted cgroups' >&2
  exit 1
fi
if [[ -r /sys/fs/cgroup/cgroup.controllers ]]; then
  for controller in cpu memory pids; do
    if ! grep -qw "$${controller}" /sys/fs/cgroup/cgroup.controllers; then
      echo 'K3s bootstrap requires cpu, memory, and pids cgroup controllers' >&2
      exit 1
    fi
  done
elif [[ ! -d /sys/fs/cgroup/memory || ! -d /sys/fs/cgroup/cpu ]]; then
  echo 'K3s bootstrap requires cpu and memory cgroups' >&2
  exit 1
fi
for utility in ip iptables modprobe sysctl; do
  if ! command -v "$${utility}" >/dev/null 2>&1; then
    echo "K3s bootstrap prerequisite is missing: $${utility}" >&2
    exit 1
  fi
done
modprobe overlay
modprobe br_netfilter
cat >/etc/modules-load.d/kordex-k3s.conf <<MODULES
overlay
br_netfilter
MODULES
cat >/etc/sysctl.d/90-kordex-k3s.conf <<SYSCTL
net.bridge.bridge-nf-call-iptables=1
net.bridge.bridge-nf-call-ip6tables=1
SYSCTL
sysctl -w net.bridge.bridge-nf-call-iptables=1 >/dev/null
sysctl -w net.bridge.bridge-nf-call-ip6tables=1 >/dev/null
[[ "$(sysctl -n net.bridge.bridge-nf-call-iptables)" == 1 ]] || { echo 'K3s bridge iptables sysctl is unavailable' >&2; exit 1; }
MACHINE_ID="$(tr -d '\n' </etc/machine-id)"
if [[ ! "$${MACHINE_ID}" =~ ^[a-f0-9]{32}$ || "$${MACHINE_ID}" == 00000000000000000000000000000000 ]]; then
  echo 'Host machine identity is unavailable or malformed; refusing K3s enrollment' >&2
  exit 1
fi

cat > /usr/local/sbin/kordex-secret-manager.py <<'PYTHON_HELPER'
${secret_helper}
PYTHON_HELPER
chmod 0755 /usr/local/sbin/kordex-secret-manager.py

INTERNAL_IP="$(curl --fail --silent --show-error -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/ip)"
if [[ "$(uname -m)" != x86_64 ]]; then
  echo "Pinned K3s artifact is linux/$${K3S_ARCH}; refusing a non-amd64 host" >&2
  exit 1
fi
# Ignore any curlrc defaults and allow only verified HTTPS. Redirect following
# is deliberately disabled: a 3xx response is not an approved mirror fetch.
curl -q --proto '=https' --max-redirs 0 --fail --silent --show-error \
  "$${K3S_BINARY_MIRROR_URL}" \
  --output /usr/local/bin/k3s
printf '%s  %s\n' "$${K3S_BINARY_SHA256}" /usr/local/bin/k3s | sha256sum --check --status

install_k3s_system_images() {
  local image_dir=/var/lib/rancher/k3s/agent/images
  local bundle="$${image_dir}/k3s-airgap-images-amd64.tar"
  local temporary
  install -d -o root -g root -m 0755 "$${image_dir}"
  if [[ -L "$${image_dir}" || ! -d "$${image_dir}" ]]; then
    echo 'K3s image staging path is unsafe' >&2
    return 1
  fi
  local unexpected
  unexpected="$(find "$${image_dir}" -mindepth 1 -maxdepth 1 ! -name k3s-airgap-images-amd64.tar -print -quit)"
  if [[ -n "$${unexpected}" ]]; then
    echo 'K3s image staging path contains an unexpected cached artifact' >&2
    return 1
  fi
  if [[ -e "$${bundle}" ]]; then
    if [[ -L "$${bundle}" || ! -f "$${bundle}" ]] || \
       ! printf '%s  %s\n' "$${K3S_SYSTEM_IMAGES_SHA256}" "$${bundle}" | sha256sum --check --status; then
      echo 'Existing K3s image archive is not the customer-approved bundle' >&2
      return 1
    fi
  else
    temporary="$(mktemp "$${image_dir}/.k3s-airgap-images.XXXXXX")"
    if ! curl -q --proto '=https' --max-redirs 0 --fail --silent --show-error \
      "$${K3S_SYSTEM_IMAGES_MIRROR_URL}" --output "$${temporary}" || \
      ! printf '%s  %s\n' "$${K3S_SYSTEM_IMAGES_SHA256}" "$${temporary}" | sha256sum --check --status; then
      rm -f "$${temporary}"
      echo 'Customer-approved K3s system-image bundle download or digest verification failed' >&2
      return 1
    fi
    chown root:root "$${temporary}"
    chmod 0644 "$${temporary}"
    if ! ln "$${temporary}" "$${bundle}"; then
      if [[ -L "$${bundle}" || ! -f "$${bundle}" ]] || \
         ! printf '%s  %s\n' "$${K3S_SYSTEM_IMAGES_SHA256}" "$${bundle}" | sha256sum --check --status; then
        rm -f "$${temporary}"
        echo 'Could not safely install the customer-approved K3s system-image bundle' >&2
        return 1
      fi
    fi
    rm -f "$${temporary}"
  fi

  install -d -o root -g root -m 0755 /etc/rancher/k3s
  local registry_config=/etc/rancher/k3s/registries.yaml
  local expected_config
  expected_config="$(printf 'mirrors:\n  docker.io:\n    endpoint:\n      - \"https://%s\"\n' "$${K3S_SYSTEM_IMAGES_REGISTRY_HOST}")"
  if [[ -e "$${registry_config}" ]]; then
    if [[ -L "$${registry_config}" || ! -f "$${registry_config}" ]] || \
       ! printf '%s' "$${expected_config}" | cmp -s - "$${registry_config}"; then
      echo 'Existing K3s registry configuration differs from the approved private mirror' >&2
      return 1
    fi
  else
    temporary="$(mktemp /etc/rancher/k3s/.registries.XXXXXX)"
    printf '%s' "$${expected_config}" > "$${temporary}"
    chown root:root "$${temporary}"
    chmod 0644 "$${temporary}"
    if ! ln "$${temporary}" "$${registry_config}"; then
      if [[ -L "$${registry_config}" || ! -f "$${registry_config}" ]] || \
         ! printf '%s' "$${expected_config}" | cmp -s - "$${registry_config}"; then
        rm -f "$${temporary}"
        echo 'Could not safely install the approved private K3s registry configuration' >&2
        return 1
      fi
    fi
    rm -f "$${temporary}"
  fi
}

install_k3s_system_images
chown root:root /usr/local/bin/k3s
chmod 0755 /usr/local/bin/k3s

# Install a small, explicit systemd unit. No remote installer script is run;
# the exact K3s binary, service command and version come from reviewed inputs.
install -d -m 0755 /etc/rancher/k3s
K3S_SERVER_SELINUX_FLAG=""
if [[ "$${OS_FAMILY}" == rhel ]]; then
  K3S_SERVER_SELINUX_FLAG=" --selinux"
fi
cat > /etc/systemd/system/k3s.service <<UNIT
[Unit]
Description=K3s server
Documentation=https://docs.k3s.io
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
EnvironmentFile=-/etc/default/k3s
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStart=/usr/local/bin/k3s server --node-ip=$${INTERNAL_IP} --cluster-cidr=10.42.0.0/16 --service-cidr=10.43.0.0/16 --write-kubeconfig-mode=0640 --disable-default-registry-endpoint$${K3S_SERVER_SELINUX_FLAG}
UNIT
chmod 0644 /etc/systemd/system/k3s.service

if [[ "$${OS_FAMILY}" == rhel ]]; then
  if [[ -L /etc/rancher/k3s || ! -d /etc/rancher/k3s || -L /etc/rancher/k3s/config.yaml || -d /etc/rancher/k3s/config.yaml ]]; then
    echo 'Refusing symlinked or unsafe K3s configuration path' >&2
    exit 1
  fi
  tmp_k3s_cfg="$(mktemp /etc/rancher/k3s/.config.yaml.XXXXXX)"
  printf 'selinux: true\n' > "$${tmp_k3s_cfg}"
  chown root:root "$${tmp_k3s_cfg}"
  chmod 0644 "$${tmp_k3s_cfg}"
  mv -f "$${tmp_k3s_cfg}" /etc/rancher/k3s/config.yaml
  restorecon -F /usr/local/bin/k3s /etc/systemd/system/k3s.service
  restorecon -RF /etc/rancher/k3s /var/lib/rancher/k3s
  [[ "$(getenforce)" == Enforcing ]] || { echo 'RHEL SELinux is not Enforcing before K3s start' >&2; exit 1; }
  grep -Eq '^[[:space:]]*SELINUX=enforcing[[:space:]]*$' /etc/selinux/config || { echo 'RHEL /etc/selinux/config does not persist SELINUX=enforcing before K3s start' >&2; exit 1; }
  semodule -l | awk '$1 == "k3s" {found=1} END {exit !found}' || { echo 'RHEL k3s SELinux policy module is missing before K3s start' >&2; exit 1; }
  grep -qx 'selinux: true' /etc/rancher/k3s/config.yaml || { echo 'K3s SELinux configuration is missing before K3s start' >&2; exit 1; }
fi

systemctl daemon-reload
systemctl enable --now k3s.service

for attempt in $(seq 1 90); do
  if /usr/local/bin/k3s kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml get --raw=/readyz >/dev/null 2>&1; then
    break
  fi
  if [[ "$${attempt}" == 90 ]]; then
    echo 'K3s API did not become ready within 15 minutes' >&2
    exit 1
  fi
  sleep 10
done

# Create one auto-expiring agent-only bootstrap token and let both workers
# consume it. Its value is piped to Secret Manager, never used as an argument,
# Terraform input, metadata value, or startup log output.
PROJECT_NUMBER="$(curl -q --proto '=http' --max-redirs 0 --fail --silent --show-error \
  -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/project/numeric-project-id)"
if [[ ! "$${PROJECT_NUMBER}" =~ ^[0-9]{1,20}$ ]]; then
  echo 'GCE numeric project identity is unavailable or malformed; refusing bootstrap token cleanup state' >&2
  exit 1
fi
install -d -m 0700 "$${BOOTSTRAP_STATE_DIR}"
if [[ -s "$${BOOTSTRAP_STATE_FILE}" ]]; then
  mapfile -t bootstrap_state < "$${BOOTSTRAP_STATE_FILE}"
  if [[ "$${#bootstrap_state[@]}" != 2 ]]; then
    echo 'Saved K3s bootstrap state is malformed; manual recovery is required' >&2
    exit 1
  fi
  BOOTSTRAP_ID="$${bootstrap_state[0]}"
  SECRET_VERSION="$${bootstrap_state[1]}"
  SECRET_VERSION_PATTERN="^projects/($${PROJECT_ID}|$${PROJECT_NUMBER})/secrets/$${SECRET_ID}/versions/[1-9][0-9]*$"
  if [[ ! "$${BOOTSTRAP_ID}" =~ ^[a-z0-9]{6}$ || \
        ! "$${SECRET_VERSION}" =~ $${SECRET_VERSION_PATTERN} ]]; then
    echo 'Saved K3s bootstrap state failed validation; manual recovery is required' >&2
    exit 1
  fi
else
  if /usr/local/sbin/kordex-secret-manager.py present \
    --project "$${PROJECT_ID}" --secret "$${SECRET_ID}" >/dev/null 2>&1; then
    echo 'An active K3s bootstrap Secret Manager version has no local recovery record; refusing to create another token' >&2
    exit 1
  else
    status=$?
    if [[ "$${status}" != 1 ]]; then
      echo 'Could not verify that no previous K3s bootstrap token is active' >&2
      exit 1
    fi
  fi
  BOOTSTRAP_TOKEN="$(/usr/local/bin/k3s token create --ttl=30m --description='Kordex disposable worker join')"
  BOOTSTRAP_ID="$${BOOTSTRAP_TOKEN##*::}"
  BOOTSTRAP_ID="$${BOOTSTRAP_ID%%.*}"
  SECRET_VERSION="$(printf '%s' "$${BOOTSTRAP_TOKEN}" | \
    /usr/local/sbin/kordex-secret-manager.py publish --project "$${PROJECT_ID}" --secret "$${SECRET_ID}")"
  unset BOOTSTRAP_TOKEN
  SECRET_VERSION_PATTERN="^projects/($${PROJECT_ID}|$${PROJECT_NUMBER})/secrets/$${SECRET_ID}/versions/[1-9][0-9]*$"
  if [[ ! "$${SECRET_VERSION}" =~ $${SECRET_VERSION_PATTERN} ]]; then
    echo 'Secret Manager returned a version outside the configured project and secret' >&2
    exit 1
  fi
  umask 0077
  printf '%s\n%s\n' "$${BOOTSTRAP_ID}" "$${SECRET_VERSION}" > "$${BOOTSTRAP_STATE_FILE}.new"
  chmod 0600 "$${BOOTSTRAP_STATE_FILE}.new"
  mv "$${BOOTSTRAP_STATE_FILE}.new" "$${BOOTSTRAP_STATE_FILE}"
fi

for attempt in $(seq 1 120); do
  all_workers_ready=true
  for worker_name in "$${WORKER_NAMES[@]}"; do
    if ! /usr/local/bin/k3s kubectl --kubeconfig=/etc/rancher/k3s/k3s.yaml \
      get node "$${worker_name}" \
      -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null | grep -qx True; then
      all_workers_ready=false
      break
    fi
  done
  if [[ "$${all_workers_ready}" == true ]]; then
    # The script may resume after an interruption between token deletion and
    # Secret Manager cleanup. Check only the ID-only text listing so this
    # cleanup step is safely repeatable without reading token payloads.
    bootstrap_token_list="$(/usr/local/bin/k3s token list)" || {
      echo 'Could not verify K3s bootstrap token state' >&2
      exit 1
    }
    if grep -Eq "^$${BOOTSTRAP_ID}[[:space:]]" <<< "$${bootstrap_token_list}"; then
      /usr/local/bin/k3s token delete "$${BOOTSTRAP_ID}" >/dev/null
    fi
    bootstrap_token_list="$(/usr/local/bin/k3s token list)" || {
      echo 'Could not verify K3s bootstrap token revocation' >&2
      exit 1
    }
    if grep -Eq "^$${BOOTSTRAP_ID}[[:space:]]" <<< "$${bootstrap_token_list}"; then
      echo 'K3s bootstrap token remains active after deletion' >&2
      exit 1
    fi
    /usr/local/sbin/kordex-secret-manager.py destroy \
      --version "$${SECRET_VERSION}" --project "$${PROJECT_ID}" --secret "$${SECRET_ID}"
    umask 0077
    : > "$${BOOTSTRAP_COMPLETE}.new"
    chmod 0600 "$${BOOTSTRAP_COMPLETE}.new"
    mv "$${BOOTSTRAP_COMPLETE}.new" "$${BOOTSTRAP_COMPLETE}"
    exit 0
  fi
  sleep 10
done

echo 'Both K3s workers did not become Ready; the join token will expire automatically' >&2
exit 1
